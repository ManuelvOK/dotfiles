" Language specific configuration {{{1
" git commit {{{2
au FileType gitcommit   setlocal spell textwidth=72 | call s:SetSpellLang('en_gb')
au FileType yaml        setlocal textwidth=80 colorcolumn=81 foldmethod=indent foldlevel=99
au FileType markdown    setlocal spell textwidth=80 colorcolumn=81 | call s:SetSpellLang('en_gb')
au FileType mail        setlocal spell | call s:SetSpellLang('de,en_gb')
au FileType python      setlocal textwidth=99 colorcolumn=100
au FileType html        setlocal shiftwidth=2 tabstop=2
au FileType htmlangular setlocal ft=html
au FileType make        setlocal iskeyword+=- tabstop=8
au FileType typescript  setlocal textwidth=99 colorcolumn=100

nnoremap gb :<C-u>call gitblame#echo()<CR>

