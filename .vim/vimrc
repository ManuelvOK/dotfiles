" Visuals {{{1
" Orientation {{{2
set number              " enable line numbers (current line absolute)
set relativenumber      " use relative line numbers
set ruler               " always show position in file
set scrolloff=5         " number of lines always below/above cursor
set wrap linebreak      " wrap on word bounds
set breakindent         " indent wrapped lines as previous line
set showcmd             " show currently pending command string
set cursorline          " highlight current line
set colorcolumn=100     " highlight column 100

" whitespaces {{{2
set list                        " show Whitespaces
set listchars=tab:\ \ ,trail:·  " show tabs as tabs and trailing spaces as dots

" Color scheme {{{2
set t_Co=256
silent! color wombat256mod      " Use wombat TODO: fork for following settings
highlight LineNr ctermbg=234
highlight TabLineFill ctermfg=234
highlight Search ctermbg=none
highlight Comment ctermfg=241
highligh ColorColumn ctermbg=233

" undercurl (wavy line) and its color in st
let &t_Cs = "\e[4:3m"
let &t_Ce = "\e[4:0m"
let &t_AU = "\e[58:5:%dm"
hi SpellBad   cterm=undercurl ctermbg=NONE ctermul=red      " unknown word
hi SpellLocal cterm=undercurl ctermbg=NONE ctermul=cyan     " word of another region (US/GB)
hi SpellCap   cterm=undercurl ctermbg=NONE ctermul=blue     " lowercase sentence start
hi SpellRare  cterm=undercurl ctermbg=NONE ctermul=magenta  " rare word

" Spelling {{{2
" British English by default. zg adds a word to the list of the first
" language in spelllang, 2zg to the other list. en_gb and en_us share en.
" zg does not expand ~ in spellfile, so the paths have to be expanded here
let s:spell_en = expand('~/.vim/spell/en.utf-8.add')
let s:spell_de = expand('~/.vim/spell/de.utf-8.add')
set spelllang=en_gb
let &spellfile = s:spell_en . ',' . s:spell_de

function! s:SetSpellLang(lang) abort
    let &l:spelllang = a:lang
    let &l:spellfile = a:lang =~# '^de'
                \ ? s:spell_de . ',' . s:spell_en
                \ : s:spell_en . ',' . s:spell_de
endfunction

" cycle en_gb -> en_us -> de,en_gb and switch spell checking on
function! s:CycleSpellLang() abort
    let l:langs = ['en_gb', 'en_us', 'de,en_gb']
    let l:next = l:langs[(index(l:langs, &l:spelllang) + 1) % len(l:langs)]
    call s:SetSpellLang(l:next)
    setlocal spell
    echo 'spelllang=' . &l:spelllang
endfunction
nnoremap <silent> <F7> :call <SID>CycleSpellLang()<CR>

