# HTML mails
text/html;                  w3m -I %{charset} -T text/html; copiousoutput;
#text/html;                  elinks -dump -dump-charset utf-8 %s; nametemplate=%s.html; copiousoutput
#text/html;                  mutt_view firefox %s; nametemplate=%s.html; test=runningx
#text/html;                  elinks %s; nametemplate=%s.html

# Diffs
text/x-diff;                cat %s | colordiff; copiousoutput;
text/x-patch;               cat %s | colordiff; copiousoutput;

# Calendar Events
text/calendar;              mutt-ics; copiousoutput;
application/ics;            mutt-ics; copiousoutput;

# other text files
text/*;                     iconv -f %{charset} -t utf-8 %s; copiousoutput;

# Everything else opens with the default application from mimeapps.list,
# like xdg-open in a shell. xdg-open looks at the content, so this also works
# for attachments that were sent as application/octet-stream.
application/*;              mutt_view xdg-open %s;
image/*;                    mutt_view xdg-open %s;
audio/*;                    mutt_view xdg-open %s;
video/*;                    mutt_view xdg-open %s;

